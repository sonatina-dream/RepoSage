# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Unauthenticated GitHub API calls are limited to 60 requests/hour
# per IP; a personal access token with no scopes raises that to 5000/hour.
GITHUB_TOKEN=

# Optional overrides (defaults live in src/reposage/config.py)
# REPOSAGE_MODEL=claude-haiku-4-5-20251001
# REPOSAGE_SPEND_CEILING_USD=1.00
