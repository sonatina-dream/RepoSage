# Copy to .env and fill in. .env is gitignored — never commit it.

# Which vendor RepoSage talks to: deepseek | anthropic
REPOSAGE_PROVIDER=deepseek

# Only the key for the provider you actually use is required.
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Optional. Unauthenticated GitHub API calls are limited to 60 requests/hour
# per IP; a personal access token with no scopes raises that to 5000/hour.
GITHUB_TOKEN=

# Optional overrides (defaults live in src/reposage/config.py)
# REPOSAGE_MODEL=deepseek-v4-flash
# REPOSAGE_SPEND_CEILING_USD=1.00
